{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "composite": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["test/**/*.ts"]
}
