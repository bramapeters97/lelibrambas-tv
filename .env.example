# Worker-only values. Copy to an ignored services/api/.dev.vars file for local work.
# Never expose either value to TV, admin, or Electron renderer bundles.
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
STREAM_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# This is a public delivery hostname, not a credential.
STREAM_DELIVERY_DOMAIN=customer-placeholder.cloudflarestream.com

# D1, R2, and Stream are direct Worker bindings configured in services/api/wrangler.jsonc.
# Keep real resource IDs, account credentials, API tokens, and private signing keys out of Git.
