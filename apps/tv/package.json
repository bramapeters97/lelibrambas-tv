{
  "name": "@lelibrambas/tv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:mobile": "cross-env EXPO_TV=0 expo start --web --lan",
    "dev:mobile-native": "cross-env EXPO_TV=0 expo start --dev-client --lan",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "prebuild:tv": "cross-env EXPO_TV=1 expo prebuild --clean --no-install",
    "prebuild:mobile": "cross-env EXPO_TV=0 expo prebuild --clean --no-install",
    "android:tv": "cross-env EXPO_TV=1 expo run:android",
    "tvos": "cross-env EXPO_TV=1 expo run:ios",
    "ios:mobile": "cross-env EXPO_TV=0 expo run:ios --device"
  },
  "dependencies": {
    "@lelibrambas/catalog": "1.0.0",
    "@lelibrambas/design-system": "1.0.0",
    "@lelibrambas/navigation": "1.0.0",
    "@lelibrambas/shared": "1.0.0",
    "@lelibrambas/types": "1.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.13",
    "expo-image": "57.0.3",
    "expo-video": "57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.2-0",
    "react-native-reanimated": "4.5.1",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@react-native/metro-config": "0.86.2",
    "@react-native-tvos/config-tv": "0.1.6",
    "cross-env": "10.1.0",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  }
}
