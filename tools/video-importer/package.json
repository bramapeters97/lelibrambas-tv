{
  "name": "@lelibrambas/video-importer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "lelibrambas-importer": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "cli": "node ../../node_modules/tsx/dist/cli.mjs src/cli.ts",
    "importer": "node ../../node_modules/tsx/dist/cli.mjs src/cli.ts",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.19.0 <25"
  }
}
