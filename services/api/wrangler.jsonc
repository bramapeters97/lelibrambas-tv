{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lelibrambas-plus-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
  "vars": {
    "STREAM_DELIVERY_DOMAIN": "customer-placeholder.cloudflarestream.com",
  },
  "secrets": {
    "required": ["ADMIN_API_TOKEN", "STREAM_WEBHOOK_SECRET"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lelibrambas-plus",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../infra/d1/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARTWORK",
      "bucket_name": "lelibrambas-plus-artwork",
    },
  ],
  "stream": {
    "binding": "STREAM",
  },
}
