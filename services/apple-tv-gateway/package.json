{
  "name": "@lelibrambas/apple-tv-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run types:check && npm run typecheck && npm test && npm run build",
    "dev": "wrangler dev --local",
    "migrate:local": "wrangler d1 migrations apply apple-tv-gateway-auth --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "types": "wrangler types ./worker-configuration.d.ts --env-interface Env --include-runtime false",
    "types:check": "wrangler types ./worker-configuration.d.ts --env-interface Env --include-runtime false --check"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260731.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  }
}
